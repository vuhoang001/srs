{
  "name": "srs-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "App on tap lap lai ngat quang (FSRS) rieng, nhap the tu kho knowledge",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "import": "tsx server/import.ts",
    "gen": "node scripts/gen.mjs",
    "pull": "node scripts/sync.mjs pull",
    "push": "node scripts/sync.mjs push",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@anthropic-ai/sdk": "^0.115.0",
    "antd": "^5.29.3",
    "better-sqlite3": "^11.8.1",
    "express": "^4.21.2",
    "fsrs-rs-nodejs": "^0.9.0",
    "highlight.js": "^11.11.1",
    "ts-fsrs": "^4.7.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "playwright": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
